# Add at least one free key to turn on the LLM agents (otherwise LIFELINE runs in offline mode).
# Gemini: https://aistudio.google.com/apikey    Groq: https://console.groq.com/keys
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional local model through Ollama:
# LIFELINE_OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_HOST=http://localhost:11434
# Optional model overrides:
# LIFELINE_GEMINI_MODEL=gemini-2.5-flash-lite
# LIFELINE_GROQ_MODEL=llama-3.3-70b-versatile
